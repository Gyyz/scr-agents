# Copy to .env and edit. .env is gitignored; this file is the documented set of
# variables the project reads. Every variable is optional.

# --- MLflow ------------------------------------------------------------------
# Where traces and runs are stored. Point at the local UI started with
# `uv run mlflow ui` so traces appear there as they are logged:
MLFLOW_TRACKING_URI=http://localhost:5000
# Or write straight to a SQLite file (the store `mlflow ui` opens by default):
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Or point at a shared tracking server:
# MLFLOW_TRACKING_URI=http://mlflow.example.com:5000
# Credentials, only if the shared server requires them (one of the two styles):
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
# MLFLOW_TRACKING_TOKEN=

# Experiment that groups this project's traces. Set it to your project name;
# MLflow falls back to its "Default" experiment when unset.
# MLFLOW_EXPERIMENT_NAME=scr-agents

# --- LLM providers -----------------------------------------------------------
# The OpenAI SDK is a project dependency because GPUStack, the company-hosted
# model server, exposes an OpenAI-compatible API. Build the client with these
# two values: OpenAI(base_url=GPUSTACK_BASE_URL, api_key=GPUSTACK_API_KEY).
# Autologging traces its calls automatically.
# GPUSTACK_BASE_URL=https://gpustack.example.com/v1
# GPUSTACK_API_KEY=
#
# Online APIs, used only when llm.mode names them (the code under review is then
# sent to that provider): llm.mode openai reads OPENAI_API_KEY, llm.mode anthropic
# reads ANTHROPIC_API_KEY (and needs `uv sync --extra anthropic`).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- scr_agents ----------------------------------------------------------------
# `scr-agents` reads this file from the working directory. GPUSTACK_BASE_URL and
# GPUSTACK_API_KEY above become its model server unless scr_agents.yaml names one
# (llm.local.base_url / api_key); the validator uses the same server unless
# llm.local.validator_base_url is set.
#
# Access token for the web console (`scr-agents serve`); empty = a new one is
# generated and printed at every start:
# SCR_AGENTS_TOKEN=
# Force the model mode: auto | local | offline (openai and anthropic are explicit opt-ins):
# SCR_AGENTS_MODE=
# Folder of MCP servers (default: mcp_servers/ in the working directory):
# SCR_AGENTS_MCP_SERVERS_DIR=
